// Jahan Alborz - Database schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
  SERVICE_MANAGER
}

enum ServiceRequestStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum ShippingMethod {
  POST
  TIPAX
  FREIGHT
  LOCAL
}

enum PurchasingMode {
  FIXED
  QUOTE
}

// Central site settings (singleton - fixed id: "default")
model SiteSettings {
  id           String   @id @default("default")
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  workHours    String?
  announcement String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Customer and administrator accounts
model User {
  id              String          @id @default(uuid())
  name            String?
  email           String?         @unique
  phone           String          @unique
  passwordHash    String?
  role            UserRole        @default(CUSTOMER)
  isActive        Boolean         @default(true)
  lastLoginAt     DateTime?
  addresses       Address[]
  orders          Order[]
  reviews         ProductReview[]
  serviceRequests ServiceRequest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([role])
  @@index([createdAt])
}

// OTP verification records (mobile number based).
// Codes are stored as SHA-256 hashes, never in plaintext.
model Otp {
  id         String    @id @default(uuid())
  phone      String    @unique
  codeHash   String
  purpose    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  sendCount  Int       @default(1)
  lastSentAt DateTime  @default(now())
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expiresAt])
}

// Fixed-window counters used for authentication and OTP rate limiting.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  recipient  String
  phone      String
  province   String
  city       String
  street     String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  visual      String    @default("boiler")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String         @id @default(uuid())
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  slug            String         @unique
  description     String
  brand           String?
  sku             String?        @unique
  price           Decimal        @db.Decimal(12, 2)
  discountedPrice Decimal?       @db.Decimal(12, 2)
  inventory       Int            @default(0)
  purchasingMode  PurchasingMode @default(FIXED)
  isActive        Boolean        @default(true)
  isFeatured      Boolean        @default(false)
  isBestSeller    Boolean        @default(false)
  visual          String         @default("boiler")
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  specifications  Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  images          ProductImage[]
  reviews         ProductReview[]
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isBestSeller])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId, isApproved])
}

model Order {
  id             String         @id @default(uuid())
  orderNumber    String         @unique
  idempotencyKey String?        @unique
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         OrderStatus    @default(PENDING)
  customerName   String
  customerPhone  String
  customerEmail  String?
  province       String?
  city           String
  postalCode     String?
  shippingAddress String
  notes          String?
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  shippingCost   Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus  @default(PENDING)
  shippingMethod ShippingMethod
  items          OrderItem[]
  payment        Payment?
  shipping       Shipping?
  statusHistory  OrderStatusEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSlug  String
  productPrice Decimal @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String?
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Shipping {
  id           String         @id @default(uuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       ShippingMethod
  cost         Decimal        @default(0) @db.Decimal(12, 2)
  trackingCode String?
  status       String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ServiceRequest {
  id                 String               @id @default(uuid())
  customerId         String?
  customer           User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  serviceType        String
  city               String?
  address            String?
  brand              String?
  problemDescription String?
  preferredVisitDate DateTime?
  assignedTo         String?
  notes              String?
  status             ServiceRequestStatus @default(PENDING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  serviceNotes       ServiceRequestNote[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([customerPhone])
}

model ServiceRequestNote {
  id        String         @id @default(uuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    String?
  note      String
  createdAt DateTime       @default(now())

  @@index([requestId, createdAt])
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  category    String?
  readTime    Int      @default(4)
  content     Json
  author      String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(uuid())
  page      String   @unique
  key       String   @unique
  value     Json?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  path      String?
  productId String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([productId, createdAt])
}
