# ---------------------------------------------------------------------------
# Jahan Alborz - environment variables
# Copy this file to `.env.local` for local development and configure the same
# variables in the Vercel project settings for production.
# ---------------------------------------------------------------------------

# Public site URL used for canonical URLs, Open Graph and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Centralized contact information (replace with real business values).
NEXT_PUBLIC_PHONE=+98 0000000000
NEXT_PUBLIC_WHATSAPP=+98 0000000000
NEXT_PUBLIC_EMAIL=info@example.com

# PostgreSQL connection string. Works with Vercel Postgres, Neon, Supabase,
# Prisma Postgres or any standard PostgreSQL provider.
# When the database runs behind a connection pooler, append `?pgbouncer=true`
# only if your provider documents it. Keep `sslmode=require` for hosted setups.
DATABASE_URL="postgresql://user:password@host:5432/jahan_alborz?sslmode=require"

# Auth.js v4 session secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-long-random-value
NEXTAUTH_URL=https://your-domain.example

# Extra secret used to sign guest order-access cookies. Falls back to
# NEXTAUTH_SECRET when omitted, but a separate value is recommended.
ORDER_ACCESS_SECRET=replace-with-another-long-random-value

# SMS provider: "mock" (development only) or "kavenegar".
SMS_PROVIDER=mock
# Required when SMS_PROVIDER=kavenegar.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Optional Kavenegar verification template name.
KAVENEGAR_TEMPLATE=jahan-alborz-otp
# Optional: phone number that receives a text alert for each new order.
# Leave empty to skip the admin alert. Use the international format (e.g. +989...).
ADMIN_ORDER_NOTIFY_PHONE=

# Payment provider: "manual" until a real Iranian gateway is connected.
PAYMENT_PROVIDER=manual

# Optional: used by `npm run db:seed` to create the first administrator.
# Use a strong unique password and rotate it after the first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
